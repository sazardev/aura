{
  "name": "aura",
  "version": "0.2.2",
  "description": "Aura — learn English at full power. Duolingo-style, 100% local, free and open source.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@12.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run copy:wn && tsc -b && vite build",
    "preview": "vite preview",
    "copy:wn": "node scripts/copy-wordnet.mjs",
    "gen:vocab": "npm run copy:wn && cargo run --manifest-path src-tauri/Cargo.toml --bin gen_vocab",
    "gen:library": "node scripts/gen-library.mjs",
    "typecheck": "tsc -b --noEmit",
    "typecheck:watch": "tsc -b --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version:check": "node scripts/check-version.mjs",
    "release:check": "node scripts/release.mjs --check",
    "release": "node scripts/release.mjs --commit",
    "docs": "typedoc",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "tauri:android": "node scripts/tauri-dev.mjs android",
    "tauri:android:build": "tauri android build",
    "tauri:ios": "node scripts/tauri-dev.mjs ios",
    "tauri:ios:build": "tauri ios build",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "analyze": "npm run version:check && npm run typecheck && npm run lint && npm run stylelint && npm run format:check",
    "ci": "npm run analyze && npm run lint:rust && npm run format:rust && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "afinn-165": "^2.0.0",
    "automated-readability": "^2.0.1",
    "coleman-liau": "^2.0.1",
    "compromise": "^14.16.0",
    "dale-chall": "^2.0.1",
    "dale-chall-formula": "^2.0.1",
    "flesch": "^2.0.1",
    "flesch-kincaid": "^2.0.1",
    "gunning-fog": "^2.0.1",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "retext": "^9.0.0",
    "retext-contractions": "^6.0.0",
    "retext-equality": "^7.1.0",
    "retext-indefinite-article": "^5.0.0",
    "retext-intensify": "^7.0.0",
    "retext-readability": "^8.0.0",
    "retext-redundant-acronyms": "^5.0.0",
    "retext-repeated-words": "^5.0.0",
    "retext-simplify": "^8.0.0",
    "smog-formula": "^2.0.1",
    "subtlex-word-frequencies": "^2.0.0",
    "supermemo": "^2.0.23",
    "syllable": "^5.0.1",
    "wink-lemmatizer": "^3.0.4",
    "wordnet-db": "^3.1.14",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
